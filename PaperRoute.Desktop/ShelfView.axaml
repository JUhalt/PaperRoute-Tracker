<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:board="using:PaperRoute.ViewModels.Board"
             x:Class="PaperRoute.Desktop.ShelfView"
             x:DataType="board:ShelfViewModel">
  <!--
    One shelf (d1 4.1): it scrolls down, never across (ManuscriptShelfPanel.vb:8-10,
    29-43), with 4 px inside (Form1.vb:1687). Step 8 of d1 section 8 builds it
    without cards: what it shows is the shelf's empty message, one full-width
    line, when the shelf is empty or the filters hide everything
    (Form1.vb:2806-2878, 3552-3566). The cards' ItemsControl comes in step 9.
  -->
  <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="ShelfPanel" Margin="4">
      <TextBlock x:Name="EmptyMessage" Classes="empty"
                 Text="{Binding EmptyMessage}"
                 IsVisible="{Binding HasEmptyMessage}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>

<!--
  Buttons (inventory C.2), with the faces of today's ActionButton
  (ManuscriptPipeline\Controls\ActionButton.vb:208-249):

    role       rest                    hovered / pressed           off (disabled)
    secondary  Card / CardBorder / Primary   Hover fill            Board / CardBorder / Muted
    primary    Accent / - / OnAccent        AccentHover / AccentPressed   Board / CardBorder / Muted
    quiet      - / - / Accent               Hover fill            - / CardBorder / Muted
    danger     Card / CardBorder / Danger    Hover fill            Board / CardBorder / Muted

  A press shows at once (no transition) and the button does not shrink, as
  today. Fluent's states set the content presenter's background, border and
  text, so each state here sets all three. The focus ring is a 2 px
  AccentSecondary ring 2 px inside the edge (OnAccent on a primary button).
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Secondary: every Button that names no other role. -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}" />
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border Margin="2" BorderThickness="2" CornerRadius="6"
                BorderBrush="{DynamicResource AccentSecondaryBrush}" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions" Value="{x:Null}" />
    <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>

  <!-- Primary: the one main action of a view. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentTextBrush}" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border Margin="2" BorderThickness="2" CornerRadius="6"
                BorderBrush="{DynamicResource OnAccentTextBrush}" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentTextBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentTextBrush}" />
  </Style>

  <!-- Quiet: link-like actions inside content, such as a card's "⋯". -->
  <Style Selector="Button.quiet">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.quiet:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Danger: destructive actions. The role is set by code, never read from the caption. -->
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- Off: every role, after the roles so it wins. A quiet button keeps no fill but gains the outline, as today. -->
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BoardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="Button.quiet:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Sizes: compact for row actions, icon for the "⋯" buttons (values proposed by inventory C.2; today's ⋯ is at least 26 px tall, Form1.vb:3150). -->
  <Style Selector="Button.compact">
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinHeight" Value="26" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="26" />
  </Style>

</Styles>

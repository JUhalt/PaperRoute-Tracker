<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PaperRoute.Desktop.App">
  <!-- The theme variant is AppTheme's alone (App.Initialize): System, Avalonia's own following of the system, until a choice is made. -->
  <!-- The trial's tokens and the five families (d1 5), after Fluent so they win. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Styles/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="/Styles/Button.axaml" />
    <StyleInclude Source="/Styles/Card.axaml" />
    <StyleInclude Source="/Styles/Pill.axaml" />
    <StyleInclude Source="/Styles/Chip.axaml" />
    <StyleInclude Source="/Styles/Tabs.axaml" />
    <StyleInclude Source="/Styles/Inputs.axaml" />
    <StyleInclude Source="/Styles/Board.axaml" />
    <StyleInclude Source="/Styles/Rail.axaml" />
  </Application.Styles>
</Application>

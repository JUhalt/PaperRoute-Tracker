<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The app's version, written here too: the manifests and the User-Agent read it from this assembly once the services move (v1.1). Keep these three equal to ManuscriptPipeline.vbproj, where the release workflow reads them. -->
    <Version>1.0.1-rc.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <AssemblyName>PaperRoute.Core</AssemblyName>
    <!-- The app's root namespace, so every moved type keeps its full name. -->
    <RootNamespace>ManuscriptPipeline</RootNamespace>
    <Product>PaperRoute Tracker</Product>
    <Authors>Joshua Uhalt</Authors>
    <Company>PaperRoute</Company>
    <Copyright>Copyright © Joshua Uhalt 2026</Copyright>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The app's version, read from its project, so About in the harness names the build it shows (#259). -->
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../ManuscriptPipeline/ManuscriptPipeline.vbproj')), '(?&lt;=&lt;Version&gt;)[^&lt;]+'))</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../ManuscriptPipeline/ManuscriptPipeline.vbproj" />
  </ItemGroup>
</Project>

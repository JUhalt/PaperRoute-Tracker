<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The same three version nodes as PaperRoute.Core.vbproj; the release build passes -p:Version and the others to every project. -->
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <AssemblyName>PaperRoute.Platform</AssemblyName>
    <!-- The app's root namespace, so every Windows type keeps its full name. -->
    <RootNamespace>ManuscriptPipeline</RootNamespace>
    <Product>PaperRoute Tracker</Product>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- DpapiSecretProtector's DPAPI calls: part of the Windows Desktop runtime the app targets, but not of plain net10.0. 10.0.0 is the .NET 10 release; in the app and its self-contained publish the runtime's own newer copy still wins. Moved from PaperRoute.Core.vbproj (core stage 2, step 8). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PaperRoute.Core\PaperRoute.Core.vbproj" />
  </ItemGroup>

</Project>

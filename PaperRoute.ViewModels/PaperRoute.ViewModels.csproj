<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Avalonia Board trial (v1.1): the library session, the view models and the Board's rules, in C# over the VB core. No Avalonia reference, so the rules are tested without a window. Nothing the Windows Forms app ships references this project. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>PaperRoute.ViewModels</AssemblyName>
    <RootNamespace>PaperRoute.ViewModels</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- A trial version, so no trial file can claim the app's version. -->
    <Version>0.1.0-trial</Version>
  </PropertyGroup>

  <!-- The shelves draw rows of N only (d1 4.4 option (b)). The every-card build that ShelfOption=a once selected was removed once rows of N was confirmed (2026-11-27), so a build still given the property stops here instead of quietly building rows of N. -->
  <Target Name="RefuseRemovedShelfOption" BeforeTargets="BeforeBuild" Condition="'$(ShelfOption)' != ''">
    <Error Text="ShelfOption was removed with the every-card shelf layout: the Board trial always draws rows of N, so build it without -p:ShelfOption." />
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Lock 3 of the trial design (d1 1.3): no call of a core save, backup or migration compiles here (RS0030, an error with TreatWarningsAsErrors). -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- The session's tests hold a load in its prepare step (the internal constructor) to show that library work runs one at a time. -->
    <InternalsVisibleTo Include="PaperRoute.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PaperRoute.Core\PaperRoute.Core.vbproj" />
  </ItemGroup>

</Project>

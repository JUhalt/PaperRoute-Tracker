<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 1.1.0-alpha.0: master's number before v1.1's first Preview. It orders above every 1.0.x and below any 1.1.0-alpha.1, -beta, -preview, -rc or 1.1.0, so an installed 1.0.x can update to a build of master. It has no release notes, so neither release.yml nor Build-ReleaseCandidate.ps1 packages it; a release sets its own number. -->
    <Version>1.1.0-alpha.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <AssemblyName>PaperRouteTracker</AssemblyName>
    <RootNamespace>ManuscriptPipeline</RootNamespace>
    <Product>PaperRoute Tracker</Product>
    <Title>PaperRoute Tracker</Title>
    <Authors>Joshua Uhalt</Authors>
    <Description>Local-first, privacy-focused app for tracking academic manuscripts from draft through submission, revision, and publication.</Description>
    <ApplicationIcon>Assets\PaperRoute.ico</ApplicationIcon>
    <Company>PaperRoute</Company>
    <Copyright>Copyright © Joshua Uhalt 2026</Copyright>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <StartupObject>ManuscriptPipeline.Program</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsForms</MyType>
    <!-- English resources only: 52 fewer files to extract and scan before Setup's first start of PaperRoute (#92). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Form1 reads workbooks with ClosedXML directly; the services that use it are in PaperRoute.Core, which references it too. -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PaperRoute.Core\PaperRoute.Core.vbproj" />
    <!-- The Windows implementations the core asks for through PlatformServices (stored keys), registered in Program.Main. -->
    <ProjectReference Include="..\PaperRoute.Platform\PaperRoute.Platform.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="My Project\Application.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\PaperRoute.png" LogicalName="PaperRoute.Logo.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\docs\USER_GUIDE.md" Link="docs\USER_GUIDE.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE.txt" Link="LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\NOTICE.md" Link="NOTICE.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>

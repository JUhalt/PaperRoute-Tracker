<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PaperRoute.Tests</AssemblyName>
    <RootNamespace>PaperRoute.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.5.2" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ManuscriptPipeline\ManuscriptPipeline.vbproj" />
    <ProjectReference Include="..\PaperRoute.TestFixtures\PaperRoute.TestFixtures.vbproj" />
  </ItemGroup>

  <!-- LargeLibraryFixture moved to PaperRoute.TestFixtures (v1.1); the tests name it as before. -->
  <ItemGroup>
    <Import Include="PaperRoute.TestFixtures" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures\Schema4Representative\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Fixtures\JournalFacts\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Fixtures\Citations\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Fixtures\JournalSuggestions\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- The Avalonia tests' parity map (v1.1), linked from its one copy: ParityMapKeyTests checks its keys against ViewCatalog. -->
  <ItemGroup>
    <None Include="..\PaperRoute.Desktop.Tests\Parity\parity-map.tsv" Link="Parity\parity-map.tsv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
